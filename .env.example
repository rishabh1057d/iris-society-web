# Create .env.local from this template using your own development Supabase project.
# Empty values are intentional. Never commit real credentials or .env.local.

# Browser configuration. The anon key is public; database grants and RLS limit access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix these names with NEXT_PUBLIC_.
# Use a development project's service-role key, not the society's production key.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated verified admin email addresses; leaving this empty denies admin access.
# Example: admin@example.com,another-admin@example.com (use actual emails only in .env.local).
# Add/remove addresses in .env.local and restart. Update Vercel Production and redeploy there.
ADMIN_EMAILS=

# POTW stays disabled until the private approved roster and R2 setup are verified.
POTW_ENABLED=
# Only the trusted feature/potw-platform Vercel Preview enables these together.
# Do not set them in Production. Local testing may set POTW_TEST_MODE=1.
POTW_PREVIEW_ENABLED=
POTW_TEST_MODE=
# Optional maximum original bytes (capped at 5242880) and total application budget.
POTW_MAX_UPLOAD_BYTES=
POTW_STORAGE_BUDGET_BYTES=
# Private Standard R2 buckets. Use bucket-scoped object read/write credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ORIGINALS_BUCKET=
R2_DISPLAY_BUCKET=
# Protects the daily Vercel maintenance endpoint. Never expose it to the browser.
CRON_SECRET=
# Isolated disposable Postgres instance for integration tests, never production.
POTW_TEST_DATABASE_URL=

# Optional: URL of the local app for tests/security-smoke.test.mjs.
# Defaults to http://localhost:3000 when omitted.
TEST_BASE_URL=

# Vercel supplies VERCEL_ENV automatically; do not set it in production .env files.
# NEXT_PUBLIC_DATABASE_DISABLED is derived by next.config.mjs at build time.
# It disables them on all previews except the explicitly enabled trusted POTW branch.
# NEXT_PUBLIC_POTW_TEST_MODE is also derived, not manually configured.
